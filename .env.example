# F1 OpenViewer — environment variables (no secrets in repo)
# Copia in .env e valorizza. Path e versione Widevine sono praticamente necessari per i contenuti DRM.

# =========================
# Electron (Main)
# =========================
# DevTools in sviluppo
ELECTRON_OPEN_DEVTOOLS=false
# Allenta CORS solo per sviluppo (manifest/segment)
ELECTRON_RELAX_CORS=false

# =========================
# Widevine CDM (necessari per contenuti DRM, es. replay 2026)
# =========================
# L'app può usare Electron castLabs (widevine incluso) oppure Electron standard con CDM di Chrome.
# In entrambi i casi è consigliato impostare path e versione qui sotto per evitare errori 6001.

# --- Come ottenere ELECTRON_WIDEVINE_CDM_PATH (Windows) ---
#
# Cartella che contiene il file widevinecdm.dll.
#
# Opzione A – Chrome in Program Files:
#   1. Apri Esplora file e vai in: C:\Program Files\Google\Chrome\Application\
#   2. Entra nella cartella con i numeri (es. 145.0.7632.162) = versione Chrome
#   3. Il path da usare è: ...\Application\VER_CHROME\WidevineCdm\_platform_specific\win_x64
#   4. Verifica che dentro ci sia widevinecdm.dll
#
# Opzione B – Chrome in User Data (se WidevineCdm non c'è in Program Files):
#   1. Nella barra indirizzi di Esplora file: %LOCALAPPDATA%\Google\Chrome\User Data\WidevineCdm
#   2. Entra nella cartella con i numeri (es. 4.10.2934.0)
#   3. Il path da usare è: ...\WidevineCdm\VER_WV\_platform_specific\win_x64
#
ELECTRON_WIDEVINE_CDM_PATH=

# --- Come ottenere ELECTRON_WIDEVINE_CDM_VERSION ---
#
# Stringa tipo 4.10.2934.0.
#
#   1. Nella cartella WidevineCdm (quella sopra _platform_specific) c'è manifest.json
#   2. Apri manifest.json e cerca la riga "version": "4.10.2934.0"
#   3. Il valore tra virgolette è ELECTRON_WIDEVINE_CDM_VERSION
#
ELECTRON_WIDEVINE_CDM_VERSION=
