{
  "name": "f1-openviewer",
  "version": "1.2.5",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "sync-version": "node scripts/sync-version.js",
    "clean:release": "node scripts/clean-release.js",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && npm run electron:dev\"",
    "vite": "vite",
    "electron:dev": "cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .",
    "prebuild": "npm run sync-version",
    "build": "vite build && npm run electron:build",
    "build:signed": "node scripts/build-and-sign-vmp.js",
    "electron:build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "private": true,
  "dependencies": {
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "axios": "^1.21.0",
    "country-flag-icons": "1.6.20",
    "dotenv": "^18.0.10",
    "framer-motion": "^14.13.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "shaka-player": "^5.3.4",
    "undici": "^8.12.4",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "github:castlabs/electron-releases#v42.11.18+wvcus",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.f1openviewer.app",
    "productName": "OpenViewer",
    "icon": "build/icon",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!electron/**/*.test.js"
    ],
    "asar": true,
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "afterPack": "scripts/apply-exe-icon.js",
    "afterSign": "scripts/evs-after-sign.js",
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.sports"
    }
  },
  "allowScripts": {
    "github:castlabs/electron-releases#1d4c9294730fd5fa95ec62081c549cd13c74bdbd": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
