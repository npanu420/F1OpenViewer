{
  "name": "f1-openviewer",
  "version": "1.1.1",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "clean:release": "node scripts/clean-release.js",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && npm run electron:dev\"",
    "vite": "vite",
    "electron:dev": "cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .",
    "prebuild": "npm run sync-version",
    "build": "vite build && npm run electron:build",
    "build:signed": "node scripts/build-and-sign-vmp.js",
    "electron:build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "private": true,
  "dependencies": {
    "@exhumer/f1tv-api": "^2.4.0",
    "@radix-ui/react-switch": "^1.2.5",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.462.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.2",
    "shaka-player": "^5.0.5",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "github:castlabs/electron-releases#v40.7.0+wvcus",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "rcedit": "^5.0.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.f1openviewer.app",
    "productName": "F1 OpenViewer",
    "icon": "build/icon",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "afterPack": "scripts/apply-exe-icon.js",
    "afterSign": "scripts/evs-after-sign.js"
  }
}
